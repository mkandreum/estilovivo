# Ejemplo de variables de entorno para Coolify

DATABASE_URL="file:./data/dev.db"
JWT_SECRET="tu_secreto_super_seguro"
PORT=3000
NODE_ENV=production
UPLOADS_DIR="/app/uploads"
FRONTEND_URL="https://estilovivo.xyoncloud.win"

# Opcionales
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Administración: IDs de usuario (separados por comas) con acceso a /api/health/detailed,
# /api/auth/test-email y /api/challenges/force-rotate. Vacío = nadie.
ADMIN_USER_IDS=

# App Android (deep links verificados): SHA-256 del certificado de firma de Google Play,
# separados por comas. Se publican en /.well-known/assetlinks.json
ANDROID_SHA256_FINGERPRINTS=
ANDROID_PACKAGE_NAME=com.estilovivo.app
